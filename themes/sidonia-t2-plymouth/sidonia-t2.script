Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
scale = Math.Min(screen_w / 2560, screen_h / 1440);
origin_x = Window.GetX() + (screen_w - 2560 * scale) / 2;
origin_y = Window.GetY() + (screen_h - 1440 * scale) / 2;

fun sx(x) { return Math.Int(global.origin_x + x * global.scale); }
fun sy(y) { return Math.Int(global.origin_y + y * global.scale); }
fun sz(n) { return Math.Int(n * global.scale + 0.5); }

fun load(file, w, h) {
  img = Image(file);
  if (global.scale != 1)
    img = img.Scale(sz(w), sz(h));
  return img;
}

fun text(str, r, g, b, pt) {
  return Image.Text(str, r, g, b, 1, "DejaVu Sans Mono " + sz(pt));
}

fun place_text(sprite, img, x, center_y) {
  sprite.SetImage(img);
  sprite.SetPosition(sx(x), sy(center_y) - Math.Int(img.GetHeight() / 2), 10);
  sprite.SetOpacity(1);
}

background = Sprite(load("background.png", 2560, 1440));
background.SetPosition(sx(0), sy(0), -100);

track = Sprite(load("track.png", 700, 24));
track.SetPosition(sx(1105), sy(1213), 4);

fill_img = Image("fill.png");
fill = Sprite();
fill.SetPosition(sx(1105), sy(1213), 5);

field_label = Sprite();
field = Sprite(load("field.png", 346, 76));
field.SetPosition(sx(1030), sy(735), 2);
field_text = Sprite();
cursor = Sprite(load("cursor.png", 12, 30));
status = Sprite();

control[0] = Sprite();
control[1] = Sprite();
place_text(control[0], text("ENTER  UNLOCK", 0.957, 0.949, 0.925, 19), 152, 1152);
place_text(control[1], text("ESC    DETAILS", 0.957, 0.949, 0.925, 19), 152, 1193);

bar_label = Sprite();

password_mode = 0;

fun set_bar_label(str) {
  place_text(global.bar_label, text(str, 0.89, 0.024, 0.075, 16), 855, 1219);
}

fun set_status(str) {
  place_text(global.status, text(str, 0.957, 0.949, 0.925, 12), 1030, 840);
}

fun set_progress(fraction) {
  w = Math.Int(Math.Clamp(fraction, 0, 1) * 700);
  if (w < 1)
    global.fill.SetOpacity(0);
  else {
    img = global.fill_img.Crop(0, 0, w, 24);
    if (global.scale != 1)
      img = img.Scale(sz(w), sz(24));
    global.fill.SetImage(img);
    global.fill.SetOpacity(1);
  }
}

fun mode_name() {
  mode = Plymouth.GetMode();
  if (mode == "shutdown") return "SHUTDOWN";
  if (mode == "reboot") return "REBOOT";
  if (mode == "suspend") return "SUSPEND";
  if (mode == "resume") return "RESUME";
  if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade") return "UPDATE";
  return "SYSTEM BOOT";
}

fun show_field(visible) {
  global.field_label.SetOpacity(visible);
  global.field.SetOpacity(visible);
  global.field_text.SetOpacity(visible);
  global.cursor.SetOpacity(visible);
  global.status.SetOpacity(visible);
}

fun draw_normal() {
  show_field(0);
  set_bar_label(mode_name());
}

fun draw_password(bullets) {
  place_text(global.field_label, text("PASSPHRASE", 0.89, 0.024, 0.075, 16), 1030, 710);
  if (bullets == 0) {
    place_text(global.field_text, text("AWAITING KEY", 0.47, 0.47, 0.46, 15), 1072, 773);
    global.cursor.SetPosition(sx(1052), sy(758), 11);
  }
  else {
    dots = "";
    for (i = 0; i < bullets && i < 10; i++) {
      if (i > 0)
        dots += " ";
      dots += "▪";
    }
    img = text(dots, 0.957, 0.949, 0.925, 20);
    place_text(global.field_text, img, 1052, 773);
    global.cursor.SetPosition(sx(1052) + img.GetWidth() + sz(10), sy(758), 11);
  }
  show_field(1);
  set_bar_label("UNLOCK");
  set_progress(0);
}

fun on_message(str) {
  set_status(str);
}

fun on_hide_message(str) {
  set_status("LOCKED");
  if (!global.password_mode)
    global.status.SetOpacity(0);
}

fun on_progress(duration, progress) {
  if (!global.password_mode)
    set_progress(progress);
}

fun on_password(prompt, bullets) {
  global.password_mode = 1;
  draw_password(bullets);
}

fun on_normal() {
  global.password_mode = 0;
  draw_normal();
}

Plymouth.SetDisplayNormalFunction(on_normal);
Plymouth.SetDisplayPasswordFunction(on_password);
Plymouth.SetDisplayMessageFunction(on_message);
Plymouth.SetHideMessageFunction(on_hide_message);
Plymouth.SetBootProgressFunction(on_progress);

set_status("LOCKED");
draw_normal();
